# Supabase project (Project Settings -> API). The anon key is safe in the browser:
# all data access is protected by row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Leave Supabase unset (or set to true) to run with the in-browser demo adapter.
# The Telegram bot that sends reminders (username without the @). Leave out to offer email only.
# VITE_TELEGRAM_BOT_USERNAME=PitStopRemindersBot

# VITE_DEMO=true
